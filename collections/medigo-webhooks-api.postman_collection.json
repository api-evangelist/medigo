              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) UUID of webhook to be triggered"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "event",
                  "description": "(Required) Event type to be triggered"
                }
              ]
            },
